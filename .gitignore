# Python cache and byte-compiled files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments
venv/
.venv/
env/
ENV/
.env

# Large raw datasets & large archive files (>100MB)
data/*.csv
data/MachineLearningCVE/
*.zip
*.tar.gz
*.tgz

# Preserve empty data folder structure
!data/.gitkeep
!results/cleaned_data/.gitkeep

# Exclude multi-hundred MB raw parquet files (370+ MB total) to keep git repository fast & clean
results/parquet/

# Spark CRC checksum metadata files
.*.crc
results/**/.*.crc

# Track all analytics reports, charts, metrics, and anomaly detection results
!results/analytics/
!results/anomalies/
!results/ml/

# Large binary ML models (>50MB, models folder tracked lightly)
models/random_forest/
models/isolation_forest.joblib

# Keep metadata and config in repo
!models/label_mapping.json
!models/feature_names.json
!models/Readme.md

# Logs & temp files
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/
.ipynb_checkpoints/
